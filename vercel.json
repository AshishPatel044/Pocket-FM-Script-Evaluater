{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm --prefix frontend install && npm --prefix backend install",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
